name: CI — Python Backend

on:
  push:
    branches: [main, develop]
    paths:
      - 'backend/**'
      - '.github/workflows/ci-python.yml'
  pull_request:
    paths:
      - 'backend/**'

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          version: "latest"
      - run: cd backend && uv sync --dev
      - run: cd backend && uv run ruff check .
      - run: cd backend && uv run ruff format --check .

  typecheck:
    name: Type Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          version: "latest"
      - run: cd backend && uv sync --dev
      - run: cd backend && uv run mypy src/

  sast:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          version: "latest"
      - run: cd backend && uv sync --dev
      - run: cd backend && uv run bandit -r src/ -ll

  test:
    name: Test
    runs-on: ubuntu-latest
    needs: [lint, typecheck]
    services:
      postgres:
        image: pgvector/pgvector:pg16
        env:
          POSTGRES_USER: test
          POSTGRES_PASSWORD: test
          POSTGRES_DB: testdb
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379
    env:
      {{ env_prefix }}_DATABASE_URL: postgresql+asyncpg://test:test@localhost:5432/testdb
      {{ env_prefix }}_REDIS_URL: redis://localhost:6379
      {{ env_prefix }}_JWT_SECRET: ci-test-secret-not-used-in-prod
      {{ env_prefix }}_ENCRYPTION_KEY: Fqn3LY3JGq0NMG7v7m7kfxl0VJvKFnUDmvHpL2cVtK4=
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v3
        with:
          version: "latest"
      - run: cd backend && uv sync --dev
      - run: cd backend && uv run alembic upgrade head
      - run: cd backend && uv run pytest tests/ -v --tb=short --cov=src --cov-report=xml
      - uses: codecov/codecov-action@v4
        if: always()
        with:
          files: backend/coverage.xml
